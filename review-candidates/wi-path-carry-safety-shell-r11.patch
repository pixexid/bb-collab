diff --git a/apps/desktop/test/fork-safety.test.ts b/apps/desktop/test/fork-safety.test.ts
new file mode 100644
index 000000000..10025fc22
--- /dev/null
+++ b/apps/desktop/test/fork-safety.test.ts
@@ -0,0 +1,61 @@
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import {
+  createForkRuntimeEnv,
+  DESKTOP_FORK_IDENTITY,
+  forkRefusesExistingServer,
+  resolveForkDataDir,
+  resolveForkSessionDataPath,
+  resolveForkUserDataPath,
+} from "../src/fork-safety.js";
+
+const userDataPath = "/tmp/bb-path-carry-user-data";
+
+describe("PATH carry fork safety", () => {
+  it("keeps identity, runtime state, and ports outside stock defaults", () => {
+    const env = createForkRuntimeEnv({ env: {}, userDataPath });
+
+    expect(DESKTOP_FORK_IDENTITY.appId).not.toBe("dev.bb.desktop");
+    expect(DESKTOP_FORK_IDENTITY.productName).not.toBe("bb");
+    expect(DESKTOP_FORK_IDENTITY.executableName).not.toBe("bb");
+    expect(resolveForkUserDataPath("/tmp/app-data")).toBe(
+      "/tmp/app-data/bb PATH Carry",
+    );
+    expect(resolveForkSessionDataPath(userDataPath)).toBe(
+      `${userDataPath}/session`,
+    );
+    expect(env.BB_DATA_DIR).toBe(resolveForkDataDir(userDataPath));
+    expect(env.BB_SERVER_PORT).toBe("39886");
+    expect(env.BB_HOST_DAEMON_PORT).toBe("39887");
+    expect(env.BB_HOST_DAEMON_AUTO_UPDATE).toBe("0");
+    expect(env.BB_FORK_INSTANCE).toBe("path-carry-r11");
+    expect(env.BB_FORK_PROTOCOL).toBe("bb-path-carry");
+    expect(env.BB_SERVER_URL).toBeUndefined();
+  });
+
+  it("fails closed when stock data or ports are injected", () => {
+    expect(() =>
+      createForkRuntimeEnv({
+        env: { BB_DATA_DIR: join(homedir(), ".bb") },
+        userDataPath,
+      }),
+    ).toThrow(/stock BB_DATA_DIR/u);
+    expect(() =>
+      createForkRuntimeEnv({
+        env: { BB_SERVER_PORT: "38886" },
+        userDataPath,
+      }),
+    ).toThrow(/refuses stock BB_SERVER_PORT/u);
+    expect(() =>
+      createForkRuntimeEnv({
+        env: { BB_HOST_DAEMON_AUTO_UPDATE: "1" },
+        userDataPath,
+      }),
+    ).toThrow(/auto-update/u);
+  });
+
+  it("never attaches to an occupied runtime", () => {
+    expect(forkRefusesExistingServer()).toBe(true);
+  });
+});
