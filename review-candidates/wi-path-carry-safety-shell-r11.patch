+    return env;
+  }
+  if (env[PATH_CARRY_FORK_ENV] !== BB_PATH_CARRY_INSTANCE_ID) {
+    throw new Error("Unknown BB fork instance; refusing runtime startup.");
+  }
+  if (env.BB_FORK_PROTOCOL !== BB_PATH_CARRY_PROTOCOL) {
+    throw new Error("PATH carry fork protocol marker is missing or invalid.");
+  }
+  if (env.BB_HOST_DAEMON_AUTO_UPDATE === "1") {
+    throw new Error("PATH carry fork refuses BB_HOST_DAEMON_AUTO_UPDATE=1.");
+  }
+  return {
+    ...env,
+    BB_DESKTOP_FORK: "1",
+    BB_HOST_DAEMON_AUTO_UPDATE: "0",
+  };
+}
 
