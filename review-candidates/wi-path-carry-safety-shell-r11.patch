diff --git a/apps/desktop/src/fork-safety.ts b/apps/desktop/src/fork-safety.ts
new file mode 100644
index 000000000..70f8bc334
--- /dev/null
+++ b/apps/desktop/src/fork-safety.ts
@@ -0,0 +1,148 @@
+import { homedir } from "node:os";
+import { join, resolve } from "node:path";
+import {
+  BB_PATH_CARRY_HOST_DAEMON_PORT,
+  BB_PATH_CARRY_INSTANCE_ID,
+  BB_PATH_CARRY_PROTOCOL,
+  BB_PATH_CARRY_SERVER_PORT,
+} from "@bb/config/runtime";
+
+export const DESKTOP_FORK_IDENTITY = {
+  appId: "dev.bb.desktop.path-carry",
+  artifactName: "bb-path-carry-${version}-${arch}.${ext}",
+  executableName: "bb-path-carry",
+  productName: "bb PATH Carry",
+} as const;
+
+export const DESKTOP_FORK_USER_DATA_NAME = "bb PATH Carry";
+export const DESKTOP_FORK_SESSION_DATA_NAME = "session";
+
+const FORK_ENV_KEYS_TO_DELETE = [
+  "BB_DESKTOP_APP_URL",
+  "BB_DESKTOP_VERSION_FEED_URL",
+  "BB_HOST_ENROLL_KEY",
+  "BB_HOST_ID",
+  "BB_HOST_TYPE",
+  "BB_SERVER_URL",
+] as const;
+
+interface CreateForkRuntimeEnvArgs {
+  allowCustomRuntime?: boolean;
+  env: NodeJS.ProcessEnv;
+  userDataPath: string;
+}
+
+function requireForkPort(
+  env: NodeJS.ProcessEnv,
+  name: string,
+  expected: number,
+  allowCustomRuntime: boolean,
+): number {
+  const configured = env[name]?.trim();
+  if (configured === undefined || configured.length === 0) {
+    return expected;
+  }
+  const port = Number(configured);
+  if (!Number.isInteger(port) || port < 1 || port > 65_535) {
+    throw new Error(`PATH carry fork refuses invalid ${name}=${configured}.`);
+  }
+  if (port === 38886 || port === 38887) {
+    throw new Error(
+      `PATH carry fork refuses stock ${name}=${configured}; use an isolated port.`,
+    );
+  }
+  if (!allowCustomRuntime && port !== expected) {
+    throw new Error(
+      `PATH carry fork refuses ${name}=${configured}; expected isolated port ${expected}.`,
+    );
+  }
+  return port;
+}
+
+export function resolveForkUserDataPath(appDataPath: string): string {
+  return join(appDataPath, DESKTOP_FORK_USER_DATA_NAME);
+}
+
+export function resolveForkSessionDataPath(userDataPath: string): string {
+  return join(userDataPath, DESKTOP_FORK_SESSION_DATA_NAME);
+}
+
+export function resolveForkDataDir(userDataPath: string): string {
+  return join(userDataPath, "runtime");
+}
+
+export function createForkRuntimeEnv(
+  args: CreateForkRuntimeEnvArgs,
+): NodeJS.ProcessEnv {
+  const dataDir = resolveForkDataDir(args.userDataPath);
+  const allowCustomRuntime = args.allowCustomRuntime === true;
+  const configuredDataDir = args.env.BB_DATA_DIR?.trim();
+  if (
+    configuredDataDir !== undefined &&
+    configuredDataDir.length > 0 &&
+    resolve(configuredDataDir) === resolve(join(homedir(), ".bb"))
+  ) {
+    throw new Error(
+      `PATH carry fork refuses stock BB_DATA_DIR=${configuredDataDir}.`,
+    );
+  }
+  if (
+    configuredDataDir !== undefined &&
+    configuredDataDir.length > 0 &&
+    !allowCustomRuntime &&
+    resolve(configuredDataDir) !== resolve(dataDir)
+  ) {
+    throw new Error(
+      `PATH carry fork refuses BB_DATA_DIR=${configuredDataDir}; expected isolated data ${dataDir}.`,
+    );
+  }
+  const serverPort = requireForkPort(
+    args.env,
+    "BB_SERVER_PORT",
+    BB_PATH_CARRY_SERVER_PORT,
+    allowCustomRuntime,
+  );
+  const daemonPort = requireForkPort(
+    args.env,
+    "BB_HOST_DAEMON_PORT",
+    BB_PATH_CARRY_HOST_DAEMON_PORT,
+    allowCustomRuntime,
+  );
+  if (args.env.BB_HOST_DAEMON_AUTO_UPDATE?.trim() === "1") {
+    throw new Error(
+      "PATH carry fork refuses host-daemon auto-update; the fork must remain disposable.",
+    );
+  }
+
+  const env = { ...args.env };
+  for (const key of FORK_ENV_KEYS_TO_DELETE) {
+    delete env[key];
+  }
+  return {
+    ...env,
+    BB_DATA_DIR:
+      configuredDataDir === undefined || configuredDataDir.length === 0
+        ? dataDir
+        : resolve(configuredDataDir),
+    BB_DESKTOP_FORK: "1",
+    BB_FORK_INSTANCE: BB_PATH_CARRY_INSTANCE_ID,
+    BB_FORK_PROTOCOL: BB_PATH_CARRY_PROTOCOL,
+    BB_HOST_DAEMON_AUTO_UPDATE: "0",
+    BB_HOST_DAEMON_PORT: String(daemonPort),
+    BB_SERVER_PORT: String(serverPort),
+  };
+}
+
+export function applyForkRuntimeEnv(args: CreateForkRuntimeEnvArgs): void {
+  const env = createForkRuntimeEnv(args);
+  for (const key of Object.keys(process.env)) {
+    if (env[key] === undefined) {
+      delete process.env[key];
+    }
+  }
+  Object.assign(process.env, env);
+}
+
+export function forkRefusesExistingServer(): boolean {
+  return true;
+}
