{
  "name": "bb-plugin-bb-collab",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.37.0",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "bb-collab",
    "description": "BB-native project governance storage and conformance boundary.",
    "branding": {
      "logo": {
        "light": "./assets/logo.svg"
      }
    },
    "server": "./dist/server.js",
    "app": "./app.tsx",
    "skills": []
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:deployed-dist": "node scripts/check-dist.mjs --deployed",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:composed-pr": "node scripts/check-composed-pr.mjs",
    "executed-profile": "node scripts/read-executed-profile.mjs",
    "throughput-report": "node scripts/weekly-throughput-report.mjs",
    "verify": "npm run typecheck && npm test && npm run build && node scripts/check-css-bundle.mjs && node scripts/role-brief-bundle.mjs && node scripts/check-dist.mjs"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@bb/plugin-sdk": "file:vendor/bb-plugin-sdk-0.4.1.tgz",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "4.13.1",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
